# ---------------------------------------------------------------------------
# ZeitTrack environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is read both by docker compose (variable substitution) and by the
# containers at runtime. Never commit your real `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL (the `db` service) ---
POSTGRES_USER=zeittrack
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=zeittrack

# --- Database connection string used by the app + migrate containers ---
# Host is the compose service name `db`. User/password/db MUST match the
# POSTGRES_* values above.
DATABASE_URL=postgresql://zeittrack:change-me-to-a-strong-password@db:5432/zeittrack?schema=public

# --- NextAuth (Auth.js v5) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-32+-character-random-secret

# Public URL the app is served from (used for auth callbacks).
# Set to your real domain in production, e.g. https://zeittrack.example.com
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Host port the app is published on ---
APP_PORT=3000

# --- First-run seeding ---
# Set to "true" for the initial `docker compose up` to load demo data, then
# set back to "false". DESTRUCTIVE: the seed wipes all existing rows first.
RUN_SEED=false
