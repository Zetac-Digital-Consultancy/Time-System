generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(EMPLOYEE)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")

  timeEntries   TimeEntry[]
  notifications Notification[]
  auditLogs     AuditLog[] @relation("AdminAuditLogs")

  @@map("users")
}

model Baustelle {
  id          String   @id @default(cuid())
  name        String
  address     String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  timeEntries TimeEntry[]

  @@map("baustellen")
}

model TimeEntry {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  workDate      DateTime        @map("work_date") @db.Date
  startTime     String          @map("start_time")
  endTime       String          @map("end_time")
  breakMinutes  Int             @default(0) @map("break_minutes")
  totalHours    Float           @map("total_hours")
  baustelleId   String?         @map("baustelle_id")
  notes         String?
  status        TimeEntryStatus @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  baustelle Baustelle? @relation(fields: [baustelleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workDate])
  @@index([status])
  @@index([baustelleId])
  @@map("time_entries")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}
